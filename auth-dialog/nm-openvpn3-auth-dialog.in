#!/usr/bin/python3
# SPDX-License-Identifier: GPL-2.0-or-later
"""Secrets prompt for openvpn3 NetworkManager connections.

Speaks the NetworkManager auth-dialog protocol: connection data and known
secrets arrive on stdin. In --external-ui-mode the prompt is described as a
key file on stdout and GNOME Shell renders it; otherwise a small GTK 4
dialog asks and the secrets are written to stdout as key/value lines.
"""

import argparse
import os
import sys
import time

import gi

sys.path.insert(0, "@pkgdatadir@")

gi.require_version("NM", "1.0")
from gi.repository import GLib, NM  # noqa: E402

from nm_openvpn3 import ovpn, pki  # noqa: E402
from nm_openvpn3 import profile_storage as ps  # noqa: E402
from nm_openvpn3.vpnplugin import PluginError  # noqa: E402

# The storage contract lives in nm_openvpn3.profile_storage; this prompt reads
# it through the same helpers the service does, so the two cannot drift.
KEY_PROFILE = ps.KEY_PROFILE
KEY_PROFILE_STORAGE = ps.KEY_PROFILE_STORAGE
STORAGE_SECRET = ps.STORAGE_SECRET
KEY_PASSWORD = "password"
KEY_CHALLENGE = "challenge-response"
KEY_CERT_PASS = "cert-pass"
HINT_MESSAGE = "x-vpn-message:"
HINT_CHALLENGE_ECHO = "x-challenge-echo"

LOCKED_PROFILE_MESSAGE = (
    "The OpenVPN profile of this connection is kept with its secrets and was not "
    "available. Unlock the wallet or keyring and try again, or load the profile "
    "again in the connection editor — no password typed here can replace it."
)
UNSUPPORTED_PROFILE_MESSAGE = (
    "This connection stores its OpenVPN profile in a layout this version does not "
    "know, so there is no way to tell which credentials it needs. Update "
    "network-manager-openvpn3."
)
_UNAVAILABLE = {ps.LOCKED: LOCKED_PROFILE_MESSAGE, ps.UNSUPPORTED: UNSUPPORTED_PROFILE_MESSAGE}


def profile_of(data, secrets):
    """The connection's profile and why there is none (see profile_storage).

    The profile is never prompted for and never written back: it is the secret
    agent that holds it.  A leftover public copy is deliberately ignored in
    secret mode and in any layout this version does not know -- it is stale by
    definition.
    """
    stored, reason = ps.stored_profile(data.get, secrets.get)
    if not stored:
        return None, reason
    try:
        return ps.decode(stored), None
    except PluginError:
        # The service reports the corrupt profile; here it only means "cannot
        # tell what is needed", same as a legacy connection without one.
        return None, ps.ABSENT


def profile_unavailable(data, secrets):
    """True when the profile itself is what is missing, not a credential."""
    return profile_of(data, secrets)[1] in _UNAVAILABLE


def needs_user_pass(config):
    if config is None:
        return True  # cannot tell: ask rather than fail silently
    return ovpn.needs_user_pass(config)


def needs_cert_pass(config):
    if config is None:
        return False
    try:
        return pki.needs_passphrase(config)
    except pki.InvalidBundle:
        return False  # the service reports the broken bundle


def secret_flags(data, key):
    """Flags of @key; NONE when the stored value is not a flags value.

    The service refuses such a connection with a D-Bus error, so this prompt
    only has to not make it worse: NONE means "ask, and let it be saved",
    while trusting the number would turn -1 into NotRequired and skip the
    field altogether.
    """
    try:
        return ps.parse_flags(data.get(key + "-flags", "0"), key)
    except PluginError:
        return NM.SettingSecretFlags.NONE


def read_vpn_details(stream):
    """Parses the connection data and secrets NetworkManager writes to stdin.

    NM.VpnServicePlugin.read_vpn_details() is unusable from Python: its
    hash tables come back without element types.
    """
    data, secrets, key = {}, {}, None
    for raw in iter(stream.readline, b""):
        line = raw.decode("utf-8").rstrip("\n")
        if line == "DONE":
            return data, secrets
        if line.startswith(("DATA_KEY=", "SECRET_KEY=")):
            key = line.split("=", 1)[1]
        elif line.startswith("DATA_VAL=") and key is not None:
            data[key], key = line[len("DATA_VAL="):], None
        elif line.startswith("SECRET_VAL=") and key is not None:
            secrets[key], key = line[len("SECRET_VAL="):], None
    raise ValueError("unexpected end of input before DONE")


class Field:
    """One prompt entry. Every field is a secret; echo only controls visibility."""

    def __init__(self, key, label, value, should_ask, echo=False):
        self.key, self.label, self.echo = key, label, echo
        self.value, self.should_ask = value, should_ask


def plan(data, secrets, hints, retry):
    """Decide which fields to show. Returns (message, fields)."""
    message = next((h[len(HINT_MESSAGE):] for h in hints if h.startswith(HINT_MESSAGE)), None)
    if KEY_CHALLENGE in hints:
        echo = HINT_CHALLENGE_ECHO in hints
        return message, [Field(KEY_CHALLENGE, message or "Response", "", True, echo=echo)]

    if KEY_CERT_PASS in hints:
        # The service found the stored passphrase wrong or missing.
        return message, [Field(KEY_CERT_PASS, "Private key passphrase", "", True)]

    config, reason = profile_of(data, secrets)
    if reason in _UNAVAILABLE:
        # Which credentials a connection needs is a property of its profile.
        # With the profile out of reach, a password prompt would be guesswork;
        # say what is actually wrong instead.
        return message or _UNAVAILABLE[reason], []
    fields = []
    for key, label, needed in ((KEY_PASSWORD, "Password", needs_user_pass(config)),
                               (KEY_CERT_PASS, "Private key passphrase", needs_cert_pass(config))):
        flags = secret_flags(data, key)
        if not needed or flags & NM.SettingSecretFlags.NOT_REQUIRED:
            continue
        existing = secrets.get(key, "")
        ask = retry or not existing or bool(flags & NM.SettingSecretFlags.NOT_SAVED)
        fields.append(Field(key, label, existing, ask))
    return message, fields


def external_ui(name, message, fields):
    kf = GLib.KeyFile()
    group = "VPN Plugin UI"
    kf.set_integer(group, "Version", 2)
    kf.set_string(group, "Description",
                  message or f"You need to authenticate to access the Virtual Private Network “{name}”.")
    kf.set_string(group, "Title", "Authenticate VPN")
    for f in fields:
        kf.set_string(f.key, "Value", f.value or "")
        kf.set_string(f.key, "Label", f.label)
        # Agents skip entries that are not secrets; a visible one-time code
        # is still a secret, only echoed.
        kf.set_boolean(f.key, "IsSecret", True)
        kf.set_boolean(f.key, "ShouldAsk", f.should_ask)
        kf.set_boolean(f.key, "ForceEcho", f.echo)
    data, _len = kf.to_data()
    sys.stdout.write(data)
    sys.stdout.flush()


def gtk_prompt(name, message, fields):
    """Returns {key: value} or None when cancelled."""
    gi.require_version("Gtk", "4.0")
    from gi.repository import Gtk

    result = {}
    loop = GLib.MainLoop()
    win = Gtk.Window(title="Authenticate VPN", modal=True, resizable=False)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12,
                  margin_top=18, margin_bottom=18, margin_start=18, margin_end=18)
    win.set_child(box)
    box.append(Gtk.Label(label=message or f"Authentication required for “{name}”.",
                         wrap=True, xalign=0))
    entries = {}
    for f in fields:
        if not f.should_ask:
            continue
        box.append(Gtk.Label(label=f.label, xalign=0))
        e = Gtk.Entry(visibility=f.echo, activates_default=True)
        e.set_text(f.value or "")
        box.append(e)
        entries[f.key] = e
    buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
    cancel = Gtk.Button(label="Cancel")
    ok = Gtk.Button(label="Connect")
    ok.add_css_class("suggested-action")
    buttons.append(cancel)
    buttons.append(ok)
    box.append(buttons)
    win.set_default_widget(ok)

    def done(accepted):
        if accepted:
            result.update({k: e.get_text() for k, e in entries.items()})
        else:
            result.clear()
            result[None] = True
        win.destroy()
        loop.quit()

    ok.connect("clicked", lambda *_: done(True))
    cancel.connect("clicked", lambda *_: done(False))
    win.connect("close-request", lambda *_: done(False) or True)
    win.present()
    loop.run()
    return None if None in result else result


def wait_for_quit():
    """NetworkManager writes QUIT once it has read the secrets."""
    os.set_blocking(0, False)
    buf, deadline = b"", time.monotonic() + 20
    while time.monotonic() < deadline:
        try:
            chunk = os.read(0, 16)
        except BlockingIOError:
            time.sleep(0.1)
            continue
        if not chunk:
            time.sleep(0.1)
            continue
        buf += chunk
        if b"QUIT" in buf or len(buf) > 10:
            return


def main():
    p = argparse.ArgumentParser(description=__doc__)
    p.add_argument("-u", "--uuid", required=True)
    p.add_argument("-n", "--name", required=True)
    p.add_argument("-s", "--service", required=True)
    p.add_argument("-i", "--allow-interaction", action="store_true")
    p.add_argument("-r", "--reprompt", action="store_true")
    p.add_argument("-t", "--hint", action="append", default=[])
    p.add_argument("--external-ui-mode", action="store_true")
    args = p.parse_args()

    try:
        data, secrets = read_vpn_details(sys.stdin.buffer)
    except (ValueError, UnicodeDecodeError) as e:
        sys.exit(f"Failed to read '{args.name}' ({args.uuid}) data and secrets from stdin: {e}")

    message, fields = plan(data, secrets, args.hint, args.reprompt)

    if args.external_ui_mode:
        external_ui(args.name, message, fields)
        return

    if not fields and profile_unavailable(data, secrets):
        # Handing back an empty answer would just make NetworkManager retry
        # and the service report its own generic failure.
        sys.exit(message)

    values = {f.key: f.value for f in fields if f.value}
    if any(f.should_ask for f in fields):
        if not args.allow_interaction:
            sys.exit(1)
        answer = gtk_prompt(args.name, message, fields)
        if answer is None:
            sys.exit(1)
        values.update(answer)
    for k, v in values.items():
        sys.stdout.write(f"{k}\n{v}\n")
    sys.stdout.write("\n\n")
    sys.stdout.flush()
    wait_for_quit()


if __name__ == "__main__":
    main()
